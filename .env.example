GOOGLE_API_KEY=
# Get one at https://aistudio.google.com/apikey (needs Pay-As-You-Go tier
# for image generation -- free tier returns RESOURCE_EXHAUSTED on image gen).

GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

MAX_SOURCE_CHARS=40000
MAX_VERIFY_RETRIES=2
SCENE_COUNT_TARGET=4

IMAGE_GENERATION_ENABLED=true
TTS_ENABLED=true

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

CACHE_DIR=data/cache
